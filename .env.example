# Copie para .env (nunca versione o .env).
# Chave do DeepSeek: modelo principal (deepseek-v4-flash).
DEEPSEEK_API_KEY=
# Chave da OpenAI: plano B (gpt-4o-mini) e moderação. Sem ela, a moderação é pulada com aviso.
OPENAI_API_KEY=
# 1 = força o plano B (OpenAI) mesmo com chave do DeepSeek.
FORCAR_PLANO_B=0
# URL da loja (incident-shop). Opcional; vazio = modo offline com dados dummy.
LOJA_URL=
