# Copie para .env (nunca versione o .env).
# Provedor do LLM de chat: deepseek | openai
LLM_PROVEDOR=openai
# Chave do DeepSeek (modelo deepseek-v4-flash).
DEEPSEEK_API_KEY=
# Chave da OpenAI (modelo gpt-4o-mini; também usada na moderação). Sem ela, a moderação é pulada com aviso.
OPENAI_API_KEY=
# URL da loja (incident-shop). Opcional; vazio = modo offline com dados dummy.
LOJA_URL=
